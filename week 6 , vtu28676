public class Solution {
    public boolean repeatedSubstringPattern(String s) {
        int n = s.length();
        int[] lps = new int[n];
        
        int prevLPS = 0;
        int i = 1;
        
        while (i < n) {
            if (s.charAt(i) == s.charAt(prevLPS)) {
                lps[i] = prevLPS + 1;
                prevLPS++;
                i++;
            } else if (prevLPS == 0) {
                lps[i] = 0;
                i++;
            } else {
                prevLPS = lps[prevLPS - 1];
            }
        }
        
        int len = lps[n - 1];
        return len > 0 && n % (n - len) == 0;
    }
}



